# ==========================================
# DJANGO CONFIGURATION
# ==========================================
DJANGO_ENVIRONMENT=development
SECRET_KEY=your-secret-key-here-generate-with-django
DEBUG=True
IS_LOCAL=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# CUSTOM URLs
# ==========================================
ADMIN_URL=admin/
API_URL=api/v1/
API_SCHEMA_URL=api/schema/
API_DOCS_URL=api/docs/
API_REDOC_URL=api/redoc/

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
DB_NAME=shelter_db
DB_USER=shelter_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# CACHE (Redis)
# ==========================================
REDIS_URL=redis://127.0.0.1:6379/1
# Required by docker-compose.yml (the redis service refuses to start without it).
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=your-redis-password

# ==========================================
# EMAIL (Brevo SMTP)
# ==========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-email@example.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-password
DEFAULT_FROM_EMAIL=noreply@example.com
STAFF_EMAIL=staff@example.com

# Optional: Brevo API Keys (if needed)
SMTP_KEY_BREVO=your-brevo-smtp-key
API_KEY_BREVO=your-brevo-api-key

# ==========================================
# GOOGLE reCAPTCHA
# ==========================================
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_PUBLIC_KEY=your-recaptcha-site-key
RECAPTCHA_PRIVATE_KEY=your-recaptcha-secret-key

# ==========================================
# CLOUDINARY (Media Storage)
# ==========================================
# Free tier: https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==========================================
# SECURITY (Production)
# ==========================================
# Comma-separated list, no spaces
CSRF_TRUSTED_ORIGINS=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# request.META key with the client IP, used by rate limiting and django-axes.
# docker-compose.yml already sets HTTP_X_REAL_IP for the bundled nginx. Without
# a reverse proxy keep REMOTE_ADDR; behind another proxy, use a header that
# proxy always overwrites (never X-Forwarded-For).
# CLIENT_IP_META_KEY=REMOTE_ADDR

# ==========================================
# ADMIN
# ==========================================
ADMIN_EMAIL=admin@example.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-admin-password

# ==========================================
# SHELTER BRANDING & CONTACTS
# ==========================================
# Shelter name, contacts, address and opening hours are NOT set here.
# Edit them in config/shelter_config.py (the single place to customize
# your shelter's public data).